[Unit]
Description=Catecash private mainnet candidate Zebra node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=catecash
Group=catecash
StateDirectory=catecash-mainnet-candidate
ExecStart=/usr/local/bin/catecash-zebrad -c /etc/catecash/mainnet-candidate.toml start
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
