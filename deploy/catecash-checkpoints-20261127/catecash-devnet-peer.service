[Unit]
Description=Catecash devnet peer checkpoint container
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=HOME=/root
ExecStartPre=-/usr/bin/podman rm -f catecash-devnet-peer
ExecStart=/usr/bin/podman run --rm --replace --pull=never --name catecash-devnet-peer --network host --read-only --cap-drop=ALL --security-opt=no-new-privileges --userns=host --user 999:988 --env XDG_CACHE_HOME=/var/lib/catecash/.cache --tmpfs /tmp:rw,nosuid,nodev,size=64m --volume /opt/catecash/peer.toml:/opt/catecash/peer.toml:ro --volume /var/lib/catecash:/var/lib/catecash:rw --entrypoint /usr/local/bin/zebrad catecash-zebra:checkpoints-20261127-arm64 -c /opt/catecash/peer.toml start
ExecStop=/usr/bin/podman stop -t 30 catecash-devnet-peer
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
