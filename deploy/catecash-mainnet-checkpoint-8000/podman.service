[Unit]
Description=Catecash mainnet Zebra checkpoint 8000 container
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
Environment=HOME=/root
ExecStartPre=-/usr/bin/podman rm -f catecash-mainnet-candidate
ExecStart=/usr/bin/podman run --rm --replace --pull=never --name catecash-mainnet-candidate --network host --read-only --cap-drop=ALL --security-opt=no-new-privileges --userns=host --user 999:988 --env XDG_CACHE_HOME=/var/lib/catecash-mainnet-candidate/.cache --tmpfs /tmp:rw,nosuid,nodev,size=64m --volume /etc/catecash/mainnet-candidate.toml:/etc/catecash/mainnet-candidate.toml:ro --volume /var/lib/catecash-mainnet-candidate:/var/lib/catecash-mainnet-candidate:rw --entrypoint /usr/local/bin/zebrad catecash-zebra:checkpoint-8000-20261126 -c /etc/catecash/mainnet-candidate.toml start
ExecStop=/usr/bin/podman stop -t 30 catecash-mainnet-candidate
Restart=on-failure
RestartSec=5
TimeoutStopSec=45

[Install]
WantedBy=multi-user.target
